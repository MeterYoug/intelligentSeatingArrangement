<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.seating.mapper.SeatStudentMapper">
    
    <resultMap type="SeatStudent" id="SeatStudentResult">
        <result property="studentId"    column="student_id"    />
        <result property="classId"    column="class_id"    />
        <result property="className"    column="class_name"    />
        <result property="studentNo"    column="student_no"    />
        <result property="studentName"    column="student_name"    />
        <result property="gender"    column="gender"    />
        <result property="heightCm"    column="height_cm"    />
        <result property="visionLevel"    column="vision_level"    />
        <result property="scoreLevel"    column="score_level"    />
        <result property="disciplineLevel"    column="discipline_level"    />
        <result property="specialNeed"    column="special_need"    />
        <result property="sortNo"    column="sort_no"    />
        <result property="status"    column="status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectSeatStudentVo">
        select ss.student_id, ss.class_id, sc.class_name, ss.student_no, ss.student_name, ss.gender,
               ss.height_cm, ss.vision_level, ss.score_level, ss.discipline_level, ss.special_need,
               ss.sort_no, ss.status, ss.del_flag, ss.create_by, ss.create_time, ss.update_by,
               ss.update_time, ss.remark
        from seat_student ss
        left join seat_class sc on sc.class_id = ss.class_id
    </sql>

    <select id="selectSeatStudentList" parameterType="SeatStudent" resultMap="SeatStudentResult">
        <include refid="selectSeatStudentVo"/>
        <where>
            ss.del_flag = '0' and sc.del_flag = '0'
            <if test="classId != null "> and ss.class_id = #{classId}</if>
            <if test="studentNo != null  and studentNo != ''"> and ss.student_no = #{studentNo}</if>
            <if test="studentName != null  and studentName != ''"> and ss.student_name like concat('%', #{studentName}, '%')</if>
            <if test="gender != null  and gender != ''"> and ss.gender = #{gender}</if>
            <if test="heightCm != null "> and ss.height_cm = #{heightCm}</if>
            <if test="visionLevel != null  and visionLevel != ''"> and ss.vision_level = #{visionLevel}</if>
            <if test="scoreLevel != null  and scoreLevel != ''"> and ss.score_level = #{scoreLevel}</if>
            <if test="disciplineLevel != null  and disciplineLevel != ''"> and ss.discipline_level = #{disciplineLevel}</if>
            <if test="specialNeed != null  and specialNeed != ''"> and ss.special_need like concat('%', #{specialNeed}, '%')</if>
            <if test="sortNo != null "> and ss.sort_no = #{sortNo}</if>
            <if test="status != null  and status != ''"> and ss.status = #{status}</if>
            <if test="params.teacherId != null"> and sc.teacher_id = #{params.teacherId}</if>
        </where>
        order by ss.class_id, ss.sort_no, ss.student_id
    </select>
    
    <select id="selectSeatStudentByStudentId" parameterType="Long" resultMap="SeatStudentResult">
        <include refid="selectSeatStudentVo"/>
        where ss.student_id = #{studentId} and ss.del_flag = '0' and sc.del_flag = '0'
    </select>

    <select id="selectSeatStudentByClassIdAndStudentNo" parameterType="SeatStudent" resultMap="SeatStudentResult">
        <include refid="selectSeatStudentVo"/>
        where ss.class_id = #{classId} and ss.student_no = #{studentNo}
          and ss.del_flag = '0' and sc.del_flag = '0'
        limit 1
    </select>

    <insert id="insertSeatStudent" parameterType="SeatStudent" useGeneratedKeys="true" keyProperty="studentId">
        insert into seat_student
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="classId != null">class_id,</if>
            <if test="studentNo != null">student_no,</if>
            <if test="studentName != null and studentName != ''">student_name,</if>
            <if test="gender != null">gender,</if>
            <if test="heightCm != null">height_cm,</if>
            <if test="visionLevel != null">vision_level,</if>
            <if test="scoreLevel != null">score_level,</if>
            <if test="disciplineLevel != null">discipline_level,</if>
            <if test="specialNeed != null">special_need,</if>
            <if test="sortNo != null">sort_no,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="classId != null">#{classId},</if>
            <if test="studentNo != null">#{studentNo},</if>
            <if test="studentName != null and studentName != ''">#{studentName},</if>
            <if test="gender != null">#{gender},</if>
            <if test="heightCm != null">#{heightCm},</if>
            <if test="visionLevel != null">#{visionLevel},</if>
            <if test="scoreLevel != null">#{scoreLevel},</if>
            <if test="disciplineLevel != null">#{disciplineLevel},</if>
            <if test="specialNeed != null">#{specialNeed},</if>
            <if test="sortNo != null">#{sortNo},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateSeatStudent" parameterType="SeatStudent">
        update seat_student
        <trim prefix="SET" suffixOverrides=",">
            <if test="classId != null">class_id = #{classId},</if>
            <if test="studentNo != null">student_no = #{studentNo},</if>
            <if test="studentName != null and studentName != ''">student_name = #{studentName},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="heightCm != null">height_cm = #{heightCm},</if>
            <if test="visionLevel != null">vision_level = #{visionLevel},</if>
            <if test="scoreLevel != null">score_level = #{scoreLevel},</if>
            <if test="disciplineLevel != null">discipline_level = #{disciplineLevel},</if>
            <if test="specialNeed != null">special_need = #{specialNeed},</if>
            <if test="sortNo != null">sort_no = #{sortNo},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where student_id = #{studentId}
    </update>

    <update id="updateStudentScoreLevel">
        update seat_student
        set score_level = #{scoreLevel}, update_by = #{updateBy}, update_time = sysdate()
        where student_id = #{studentId} and del_flag = '0'
    </update>

    <delete id="deleteSeatStudentByStudentId" parameterType="Long">
        update seat_student set del_flag = '2' where student_id = #{studentId}
    </delete>

    <delete id="deleteSeatStudentByStudentIds" parameterType="String">
        update seat_student set del_flag = '2' where student_id in
        <foreach item="studentId" collection="array" open="(" separator="," close=")">
            #{studentId}
        </foreach>
    </delete>
</mapper>
