<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.seating.mapper.SeatExamMapper">

    <resultMap type="SeatExam" id="SeatExamResult">
        <result property="examId" column="exam_id" />
        <result property="classId" column="class_id" />
        <result property="className" column="class_name" />
        <result property="examName" column="exam_name" />
        <result property="examDate" column="exam_date" />
        <result property="schoolStageSnapshot" column="school_stage_snapshot" />
        <result property="gradeCodeSnapshot" column="grade_code_snapshot" />
        <result property="gradeNameSnapshot" column="grade_name_snapshot" />
        <result property="subjectSnapshot" column="subject_snapshot" />
        <result property="isCurrent" column="is_current" />
        <result property="status" column="status" />
        <result property="delFlag" column="del_flag" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectSeatExamVo">
        select se.exam_id, se.class_id, sc.class_name, se.exam_name, se.exam_date,
               se.school_stage_snapshot, se.grade_code_snapshot, se.grade_name_snapshot,
               se.subject_snapshot, se.is_current, se.status, se.del_flag,
               se.create_by, se.create_time, se.update_by, se.update_time, se.remark
        from seat_exam se
        left join seat_class sc on sc.class_id = se.class_id
    </sql>

    <select id="selectSeatExamList" parameterType="SeatExam" resultMap="SeatExamResult">
        <include refid="selectSeatExamVo"/>
        <where>
            se.del_flag = '0' and sc.del_flag = '0'
            <if test="classId != null"> and se.class_id = #{classId}</if>
            <if test="examName != null and examName != ''"> and se.exam_name like concat('%', #{examName}, '%')</if>
            <if test="isCurrent != null and isCurrent != ''"> and se.is_current = #{isCurrent}</if>
            <if test="status != null and status != ''"> and se.status = #{status}</if>
            <if test="params.teacherId != null"> and sc.teacher_id = #{params.teacherId}</if>
        </where>
        order by se.exam_date desc, se.exam_id desc
    </select>

    <select id="selectSeatExamByExamId" parameterType="Long" resultMap="SeatExamResult">
        <include refid="selectSeatExamVo"/>
        where se.exam_id = #{examId} and se.del_flag = '0' and sc.del_flag = '0'
    </select>

    <insert id="insertSeatExam" parameterType="SeatExam" useGeneratedKeys="true" keyProperty="examId">
        insert into seat_exam
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="classId != null">class_id,</if>
            <if test="examName != null and examName != ''">exam_name,</if>
            <if test="examDate != null">exam_date,</if>
            <if test="schoolStageSnapshot != null">school_stage_snapshot,</if>
            <if test="gradeCodeSnapshot != null">grade_code_snapshot,</if>
            <if test="gradeNameSnapshot != null">grade_name_snapshot,</if>
            <if test="subjectSnapshot != null">subject_snapshot,</if>
            <if test="isCurrent != null">is_current,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="classId != null">#{classId},</if>
            <if test="examName != null and examName != ''">#{examName},</if>
            <if test="examDate != null">#{examDate},</if>
            <if test="schoolStageSnapshot != null">#{schoolStageSnapshot},</if>
            <if test="gradeCodeSnapshot != null">#{gradeCodeSnapshot},</if>
            <if test="gradeNameSnapshot != null">#{gradeNameSnapshot},</if>
            <if test="subjectSnapshot != null">#{subjectSnapshot},</if>
            <if test="isCurrent != null">#{isCurrent},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateSeatExam" parameterType="SeatExam">
        update seat_exam
        <trim prefix="SET" suffixOverrides=",">
            <if test="classId != null">class_id = #{classId},</if>
            <if test="examName != null and examName != ''">exam_name = #{examName},</if>
            <if test="examDate != null">exam_date = #{examDate},</if>
            <if test="schoolStageSnapshot != null">school_stage_snapshot = #{schoolStageSnapshot},</if>
            <if test="gradeCodeSnapshot != null">grade_code_snapshot = #{gradeCodeSnapshot},</if>
            <if test="gradeNameSnapshot != null">grade_name_snapshot = #{gradeNameSnapshot},</if>
            <if test="subjectSnapshot != null">subject_snapshot = #{subjectSnapshot},</if>
            <if test="isCurrent != null">is_current = #{isCurrent},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where exam_id = #{examId}
    </update>

    <update id="clearCurrentByClassId">
        update seat_exam set is_current = '0', update_by = #{updateBy}, update_time = sysdate()
        where class_id = #{classId} and del_flag = '0'
    </update>

    <delete id="deleteSeatExamByExamId" parameterType="Long">
        update seat_exam set del_flag = '2' where exam_id = #{examId}
    </delete>

    <delete id="deleteSeatExamByExamIds" parameterType="String">
        update seat_exam set del_flag = '2' where exam_id in
        <foreach item="examId" collection="array" open="(" separator="," close=")">
            #{examId}
        </foreach>
    </delete>
</mapper>
